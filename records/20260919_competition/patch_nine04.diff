nished=None;until=deadline;answers=0\n    while clock.monotonic()<until and not is_shutdown():\n        check_disabled()\n        try:event=events.get(timeout=min(.2,max(.001,until-clock.monotonic())))\n        except queue.Empty:continue\n        if event.get('request_id')!=rid:continue\n        record(event);status=event.get('status')\n        if status=='model_answer':answers+=1\n        if status=='plan_published':raise RuntimeError('unexpected executable plan during read-only T1')\n        if status=='request_rejected':\n            return {'result':event,'completion':None,'continue_batch':False,\n                    'classification':'request_failure','model_answers_observed':answers,'grading':'not_graded'}\n        if status in ('dry_run_validated','rejected'):\n            if terminal is not None:raise RuntimeError('duplicate terminal result for one T1 request')\n            terminal=event;until=clock.monotonic()+completion_timeout\n        elif status=='request_finished':finished=event\n        if terminal is not None and finished is not None:\n            if (finished.get('completion_protocol')!='tcei.nine.request_finished.v1'\n                    or finished.get('scope')!='nine_inference_request'\n                    or finished.get('terminal_status')!=terminal['status'] or finished.get('idle') is not True):\n                raise RuntimeError('request completion receipt is mismatched or not idle')\n            return {'result':terminal,'completion':finished,'continue_batch':True,\n                    'classification':terminal_classification(terminal),\n                    'model_answers_observed':answers,'grading':'not_graded'}\n    if terminal is not None:\n        raise TimeoutError('terminal received but matching Nine idle/finished receipt missing')\n    raise TimeoutError('T1 model request timed out')\n"},{"start":17,"end":17,"replacement":"    parser.add_argument('--completion-timeout',type=float,default=5.)\n"},{"start":18,"end":18,"replacement":"  