  (args.output/'summary.json').write_text(json.dumps(summary,ensure_ascii=False,indent=2),encoding='utf-8')\n    print(json.dumps({'output':str(args.output),'requests':len(results),'actions_enabled':False,\n                      'operational_failures':operational_failures,'batch_error':batch_error}))\n    return 1 if batch_error or operational_failures else 0\n"}]}]}