--- a/modeling_fm9gv.py.bak_prepatch
+++ b/modeling_fm9gv.py
@@ -174,6 +174,9 @@
         if position_ids.dtype != torch.int64:
             position_ids = position_ids.long()
 
+        kwargs.pop("_input_ids_guard", None)
+        for _k in ("input_ids", "position_ids", "inputs_embeds"):
+            kwargs.pop(_k, None)
         return self.llm(
             input_ids=None,
             position_ids=position_ids,
